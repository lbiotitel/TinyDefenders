    m_Metadata:
      m_Items: []
  - m_Id: 2238676055924736
    m_Localized: "(1) 20%\uD655\uB960\uB85C \uC801\uC5D0\uAC8C 1.5\uCD08\uAC04 \uAE30\uC808\uC744
      \uBD80\uC5EC\uD55C\uB2E4.\\n\n(2) 40%\uD655\uB960\uB85C \uC801\uC5D0\uAC8C
