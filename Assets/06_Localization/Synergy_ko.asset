  - m_Id: 722927046926336
    m_Localized: "\uB178\uB828\uD55C \uC800\uACA9\uC19C\uC528"
    m_Metadata:
      m_Items: []
  - m_Id: 723044340637696
    m_Localized: "(1) \uD5CC\uD130 \uD074\uB798\uC2A4\uC758 \uD06C\uB9AC\uD2F0\uCEEC
      \uB370\uBBF8\uC9C0\uAC00 25% \uC99D\uAC00\uD55C\uB2E4.\\n\n(2) \uD5CC\uD130
      \uD074\uB798\uC2A4\uC758 \uD06C\uB9AC\uD2F0\uCEEC \uB370\uBBF8\uC9C0\uAC00
      50% \uC99D\uAC00\uD55C\uB2E4.\\n\n(3) \uD5CC\uD130 \uD074\uB798\uC2A4\uB294
      \uAC70\uB9AC\uC5D0 \uBE44\uB840\uD558\uC5EC \uB370\uBBF8\uC9C0\uAC00 \uC99D\uAC00\uD55C\uB2E4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 1608480525164544
    m_Localized: "(1) \uC6E8\uC774\uBE0C\uAC00 \uB05D\uB0A0 \uC2DC 1 \uACE8\uB4DC
