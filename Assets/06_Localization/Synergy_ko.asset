      \uC9C0\uAE09"
    m_Metadata:
      m_Items: []
  - m_Id: 1608452515602432
    m_Localized: "\uC57D\uD0C8\uC790 \uC2DC\uB108\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 1609496280735744
    m_Localized: "\uCC3D \uC2DC\uB108\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 1609574726803456
    m_Localized: "(1) \uCC3D \uD074\uB798\uC2A4 \uC601\uC6C5\uC758 \uC0AC\uAC70\uB9AC
      0.5 \uCE78 \uC99D\uAC00\\n\n(2) \uCC3D \uD074\uB798\uC2A4\uC601\uC6C5\uC758
      \uC0AC\uAC70\uB9AC 1\uCE78 \uC99D\uAC00\\n\n(3) \uCC3D \uD074\uB798\uC2A4\uB294
      \uACF5\uACA9\uD560 \uB54C \uB9C8\uB2E4 \uACF5\uACA9 \uC18D\uB3C4\uAC00 2%\uC529
      \uC99D\uAC00\uD55C\uB2E4. (\uCD5C\uB300 80%)"
    m_Metadata:
      m_Items: []
  - m_Id: 1617069906108416
    m_Localized: "\uB85C\uADF8 \uC2DC\uB108\uC9C0"
    m_Metadata:
      m_Items: []
  - m_Id: 1617127632314368
    m_Localized: "(1) \uC544\uAD70 \uC804\uCCB4 \uD06C\uB9AC\uD2F0\uCEEC \uD655\uB960
      10% \uC0C1\uC2B9\\n\n(2) \uC544\uAD70 \uC804\uCCB4 \uD06C\uB9AC\uD2F0\uCEEC
      \uD655\uB960 20% \uC0C1\uC2B9\\n\n(3) \uC544\uAD70 \uC804\uCCB4 \uD06C\uB9AC\uD2F0\uCEEC
      \uD655\uB960 30% \uC0C1\uC2B9 \uC801\uC758 hp\uAC00 5% \uBBF8\uB9CC\uC77C\uC2DC
      \uC989\uC2DC\n\uCC98\uCE58\uD55C\uB2E4(\uBCF4\uC2A4 \uC81C\uC678)\n"
    m_Metadata:
      m_Items: []
  - m_Id: 2238124945350656
    m_Localized: "(1) 20%\uD655\uB960\uB85C \uACF5\uACA9\uB825\uC758 20%\uB85C \uCD94\uAC00
      \uB370\uBBF8\uC9C0\uB97C \uBC1C\uC0DD \uC2DC\uD0A8\uB2E4.\\n\n(2) 30%\uD655\uB960\uB85C
      \uACF5\uACA9\uB825\uC758 40%\uB85C \uCD94\uAC00 \uB370\uBBF8\uC9C0\uB97C \uBC1C\uC0DD
      \uC2DC\uD0A8\uB2E4.\\n\n(3) 40%\uD655\uB960\uB85C \uACF5\uACA9\uB825\uC758
      60%\uB85C \uCD94\uAC00 \uB370\uBBF8\uC9C0\uB97C \uBC1C\uC0DD \uC2DC\uD0A8\uB2E4.\\n\n(4)
      50%\uD655\uB960\uB85C \uACF5\uACA9\uB825\uC758 100%\uB85C \uCD94\uAC00 \uB370\uBBF8\uC9C0\uB97C
      \uBC1C\uC0DD \uC2DC\uD0A8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2238093802643456
    m_Localized: "\uC804\uC0AC\uC758 \uBD84\uB178"
    m_Metadata:
